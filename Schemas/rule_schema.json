{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel scheduled analytics rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "display_name", "description", "severity", "enabled", "query",
    "query_frequency", "query_period", "trigger_operator", "trigger_threshold",
    "mitre_mapping", "entity_mappings", "incident_configuration", "event_grouping",
    "meta", "version", "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "display_name": { "type": "string", "minLength": 5, "maxLength": 100 },
    "description": { "type": "string", "minLength": 20 },
    "severity": { "enum": ["Informational", "Low", "Medium", "High"] },
    "enabled": { "type": "boolean" },
    "query": { "type": "string", "minLength": 10, "maxLength": 10000 },
    "query_frequency": { "$ref": "#/$defs/duration" },
    "query_period": { "$ref": "#/$defs/duration" },
    "trigger_operator": { "enum": ["GreaterThan", "LessThan", "Equal", "NotEqual"] },
    "trigger_threshold": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "suppression_enabled": { "type": "boolean" },
    "suppression_duration": { "$ref": "#/$defs/duration" },
    "mitre_mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tactic", "techniques"],
        "properties": {
          "tactic": { "$ref": "#/$defs/tactic" },
          "techniques": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^T\\d{4}$" }
          }
        }
      }
    },
    "entity_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "field_mappings"],
        "properties": {
          "entity_type": { "$ref": "#/$defs/entity_type" },
          "field_mappings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "column_name"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "column_name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "incident_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create_incident", "grouping_enabled"],
      "properties": {
        "create_incident": { "type": "boolean" },
        "grouping_enabled": { "type": "boolean" }
      }
    },
    "custom_details": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "event_grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation_method"],
      "properties": {
        "aggregation_method": { "enum": ["AlertPerResult", "SingleAlert"] }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "kind": { "enum": ["Scheduled"] }
  },
  "if": {
    "properties": { "suppression_enabled": { "const": true } },
    "required": ["suppression_enabled"]
  },
  "then": { "required": ["suppression_duration"] },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^P(?:[1-9][0-9]*D|T[1-9][0-9]*[HM])$"
    },
    "tactic": {
      "enum": [
        "Reconnaissance", "ResourceDevelopment", "InitialAccess", "Execution",
        "Persistence", "PrivilegeEscalation", "DefenseEvasion", "CredentialAccess",
        "Discovery", "LateralMovement", "Collection", "CommandAndControl",
        "Exfiltration", "Impact", "ImpairProcessControl", "InhibitResponseFunction"
      ]
    },
    "entity_type": {
      "enum": [
        "Account", "Host", "IP", "Malware", "File", "Process", "CloudApplication", "DNS",
        "AzureResource", "FileHash", "RegistryKey", "RegistryValue", "SecurityGroup", "URL",
        "Mailbox", "MailCluster", "MailMessage", "SubmissionMail"
      ]
    }
  }
}